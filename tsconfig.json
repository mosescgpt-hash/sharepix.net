{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "amplify/functions/**/handler.ts",
    // A local operator script that imports the generated amplify_outputs.json.
    // That file is gitignored and only exists after a deploy or sandbox run, so
    // including it here made `next build` fail on any fresh clone — including
    // CI — for a file the site never bundles.
    "scripts/**/*.ts"
  ]
}
